// The consumer half of github.com/fboldog/rp2350-amiga src/Host.c,
// unchanged except where marked "frank-amiga". Upstream it drained a ring
// filled by core 0 of the same chip; here the ring is filled by the link
// receiver (stream.c) with the slave's messages, in the same format
// (HostRing.h). Paula's line records arrive in the same ring (MSG_AUDIO).
// Generated by tools/gen_denise_c1.py from the upstream file.

#include "denise.h"
#include "denise_frames.h"
#include "Host.h"
#include "HostRing.h"
#include "../omega/DisplayLayout.h"
#include "../omega/Audio.h"

#include "pico/stdlib.h"
#include "hardware/sync.h"
#include <string.h>

#define SPRITE_X_BIAS 64   // raster x + bias fits the 10-bit field (Host.c)
#define AUDIO_SERVICE() denise_audio_service()

// ── The message ring (filled by stream.c on core 0) ───────────────────────
#ifndef RING_WORDS
#define RING_WORDS 16384u // 64 KB
#endif
#define RING_SPAN (2u * RING_WORDS)
#ifndef OMEGA_RING_SKIP_WORDS
#define OMEGA_RING_SKIP_WORDS (RING_WORDS - MSG_MAX_WORDS)
#endif
static uint32_t ring[RING_WORDS];
static volatile uint32_t ring_head; // published position (stream.c)
static volatile uint32_t ring_tail; // consume position (core 1)

static inline uint32_t ringAdvance(uint32_t pos, uint32_t words) {
    pos += words;
    return pos >= RING_SPAN ? pos - RING_SPAN : pos;
}
static inline uint32_t ringFill(uint32_t head, uint32_t tail) {
    return head >= tail ? head - tail : head + RING_SPAN - tail;
}
static inline uint32_t ringSlot(uint32_t pos) {
    return pos >= RING_WORDS ? pos - RING_WORDS : pos;
}
static volatile uint32_t c1_oldest_frame;
volatile uint32_t denise_audio_lines, denise_audio_long;

uint32_t denise_ring_space(void) {
    return RING_WORDS - ringFill(ring_head, __atomic_load_n(&ring_tail, __ATOMIC_ACQUIRE));
}

void denise_ring_put(const uint32_t *words, uint32_t count) {
    uint32_t head = ring_head;
    uint32_t slot = ringSlot(head);
    for (uint32_t i = 0; i < count; ++i) {
        ring[slot] = words[i];
        if (++slot == RING_WORDS) slot = 0;
    }
    __atomic_store_n(&ring_head, ringAdvance(head, count), __ATOMIC_RELEASE);
    __sev();
}

